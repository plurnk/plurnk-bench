{
    "name": "@plurnk/plurnk-bench",
    "version": "3.0.0",
    "description": "Benchmarking harnesses for the plurnk agent service — drive real benchmark task sets through @plurnk/plurnk, store/score/report the runs.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "test:lint": "tsc --noEmit && node ../plurnk-service/plurnk-spec-check/check.mjs .",
        "test:driver": "python -m unittest discover -s deepswe -p 'test_*.py' && python -m unittest discover -s enterprise -p 'test_*.py' && python -m unittest discover -s terminal_bench -p 'test_*.py' && python -m unittest discover -s swebench -p 'test_*.py'",
        "test:unit": "node --test 'src/**/*.test.ts' 'tiers/*.test.ts' 'deepswe/**/*.test.ts' 'swebench/**/*.test.ts' 'swebench/**/*.test.mjs' 'atlas/**/*.test.ts' 'enterprise/**/*.test.ts' 'terminal_bench/**/*.test.ts'",
        "test": "npm run test:lint && npm run test:driver && npm run test:unit",
        "tier:live": "tiers/live.sh",
        "tier:demo": "tiers/demo.sh",
        "swebench": "swebench/run.sh",
        "ht30": "swebench/campaign.sh --corpus harnesstax-swe-lite-30",
        "gimpbench": "swebench/campaign.sh --corpus gimpbench"
    },
    "dependencies": {
        "@modelcontextprotocol/client": "2.4.0",
        "@modelcontextprotocol/server": "2.4.0",
        "@plurnk/plurnk-contracts": "^11.0.0",
        "@plurnk/plurnk-digest": "^4.0.3",
        "@plurnk/plurnk-models": "^4.1.0",
        "@plurnk/plurnk-service": "^10.0.0",
        "@streamparser/json": "^0.0.26"
    },
    "devDependencies": {
        "@types/node": "^26.6.7",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "@google/genai@2.32.0": false,
        "exifreader@4.56.0": false,
        "protobufjs@7.6.6": false
    }
}
