# Portable defaults for the host-side DeepSWE diagnostic benchlet.
# Operator model aliases remain in ~/.plurnk/.env and credentials remain in
# the invoking shell; these knobs configure only benchmark orchestration.
PLURNK_BENCHLET_MODEL=grok
PLURNK_BENCHLET_TASK=abs-module-cache-flags
PLURNK_BENCHLET_CANDIDATE_TIMEOUT_SEC=5280
# Additional wall time for deterministic source builds, startup, shutdown, and digest.
PLURNK_BENCHLET_CANDIDATE_OVERHEAD_SEC=900
PLURNK_BENCHLET_REQUIEM=1
# Independent high-context witness for the complete, unabridged forensic record.
PLURNK_BENCHLET_REQUIEM_MODEL=glm
# Maximum wall time for the out-of-band forensic witness call.
PLURNK_BENCHLET_REQUIEM_TIMEOUT_SEC=1800
PLURNK_BENCHLET_OPERATOR_ENV=~/.plurnk/.env
PLURNK_BENCHLET_TASK_CACHE=.cache/deep-swe/tasks
PLURNK_BENCHLET_REPOSITORY_CACHE_ROOT=.cache/benchlet/repositories
PLURNK_BENCHLET_RUNS_ROOT=../../benchmarks
PLURNK_BENCHLET_SERVICE_ROOT=../plurnk-service
PLURNK_BENCHLET_CLIENT_ROOT=../plurnk

# MCP-Atlas current-protocol adapter and sandbox orchestration.
PLURNK_BENCH_ATLAS_IMAGE=ghcr.io/scaleapi/mcp-atlas:1.2.7
PLURNK_BENCH_ATLAS_TASK=filesystem-read-text
PLURNK_BENCH_ATLAS_MODEL=grok
PLURNK_BENCH_ATLAS_CONTAINER_PORT=1984
PLURNK_BENCH_ATLAS_LIST_TIMEOUT_MS=180000
PLURNK_BENCH_ATLAS_TOOL_TIMEOUT_MS=60000
PLURNK_BENCH_ATLAS_READY_POLL_MS=500
PLURNK_BENCH_ATLAS_READY_REQUEST_TIMEOUT_MS=5000
PLURNK_BENCH_ATLAS_CANDIDATE_TIMEOUT_SEC=900
PLURNK_BENCH_ATLAS_CANDIDATE_OVERHEAD_SEC=900
PLURNK_BENCH_ATLAS_MAX_TURNS=10
PLURNK_BENCH_ATLAS_FILES_ITEMS=-1
PLURNK_BENCH_ATLAS_REQUIEM=1
PLURNK_BENCH_ATLAS_REQUIEM_MODEL=grok
PLURNK_BENCH_ATLAS_REQUIEM_TIMEOUT_SEC=1800
PLURNK_BENCH_ATLAS_OPERATOR_ENV=~/.plurnk/.env
PLURNK_BENCH_ATLAS_RUNS_ROOT=../../benchmarks
PLURNK_BENCH_ATLAS_SERVICE_ROOT=../plurnk-service
PLURNK_BENCH_ATLAS_CLIENT_ROOT=../plurnk
